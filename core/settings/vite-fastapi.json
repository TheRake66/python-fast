{
  "services": {
    "backend": "start python -m uvicorn api.main:application --reload --host 0.0.0.0 --port 8000",
    "frontend": "start npm run dev -- --host 0.0.0.0 --port 3000"
  },
  "constants": {
    "creator_name": "TheRake66",
    "licence_name": "GPL-3.0",
    "language_short": "fr",
    "language_full": "fr-FR",
    "language_name": "French",
    "backend_ip": "127.0.0.1",
    "backend_port": "8000"
  },
  "modules": [
    "calendar",
    "system"
  ],
  "suffixs": [
    ".tsx",
    ".ts",
    ".py",
    ".scss",
    ".json",
    ".html",
    ".md"
  ],
