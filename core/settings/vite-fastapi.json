    "service": "https://github.com/TheRake66/templates-vite-fastapi/raw/refs/heads/main/template_service.zip",
    "library": "https://github.com/TheRake66/templates-vite-fastapi/raw/refs/heads/main/template_library.zip",
    "locale": "https://github.com/TheRake66/templates-vite-fastapi/raw/refs/heads/main/template_locale.zip",
