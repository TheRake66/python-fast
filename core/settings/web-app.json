{
  "services": {
    "backend": "python backend/start.py",
    "frontend": "npm --prefix frontend run dev",
    "install": "npm --prefix frontend install && python backend/setup.py",
    "compile": "npm --prefix frontend run build"
  },
  "constants": {
    "creator_name": "TheRake66",
    "licence_name": "GPL-3.0",
    "language_short": "fr",
    "language_full": "fr-FR",
    "language_name": "French"
  },
  "modules": [
    "calendar",
    "system"
  ],
  "suffixs": [
    ".tsx",
    ".ts",
    ".py",
    ".scss",
    ".json",
    ".yaml",
    ".yml",
    ".html",
    ".md"
  ],
  "templates": {
    "component": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_component.zip",
    "project": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_project.zip",
    "service": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_service.zip",
    "library": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_library.zip",
    "helper": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_helper.zip",
    "locale": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_locale.zip",
    "style": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_style.zip",
    "store": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_store.zip",
    "table": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_table.zip",
    "route": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_route.zip",
    "enum": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_enum.zip",
    "hook": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_hook.zip",
    "page": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_page.zip",
    "type": "https://github.com/TheRake66/templates-web-app/raw/refs/heads/main/template_type.zip"
  }
}